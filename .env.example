# Copy this file to ".env" and fill both values in.

# SEC requires every request to identify who is making it: a name + contact email.
# Requests without this are blocked with HTTP 403.
SEC_USER_AGENT=YourName your.email@example.com

# Your private ntfy topic. Anyone who knows the name can read it, so make it
# long and random, e.g. secwatch-k-7f3a9c2e81
NTFY_TOPIC=secwatch-change-me-to-something-random
NTFY_SERVER=https://ntfy.sh
